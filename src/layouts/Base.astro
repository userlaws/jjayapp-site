---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const wrapClass = wide ? 'wrap wrap-wide' : 'wrap';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const nav = [
  { href: '/changelog', label: 'Changelog' },
  { href: '/support', label: 'Support' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon-64.png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JJAY Campus Companion" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="JJAY Campus Companion — one app for John Jay students, free on the App Store"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="apple-itunes-app" content="app-id=6761637912" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class={wrapClass}>
        <a class="brand" href="/" aria-label="JJAY Campus Companion — home">
          <img class="brand-mark" src="/icon-64.png" alt="" width="64" height="64" />
          <span>JJAY Campus Companion</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a class="btn-pill" href="https://apps.apple.com/app/id6761637912">
            <svg class="pill-apple" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path
                d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
              ></path>
            </svg>
            Download
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class={wrapClass}>
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class={wrapClass}>
        <nav class="footer-nav" aria-label="Footer">
          <a href="/changelog">Changelog</a>
          <a href="/support">Support</a>
          <a href="/privacy">Privacy</a>
          <a href="mailto:support@jjayapp.com">support@jjayapp.com</a>
        </nav>
        <p class="disclaimer">
          JJAY Campus Companion is an independent student project. It is not affiliated with,
          endorsed by, or sponsored by John Jay College of Criminal Justice or The City University
          of New York.
        </p>
        <p class="copyright">© 2026 JJAY Campus Companion</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const header = document.querySelector('.site-header');
        if (!header) return;
        const update = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
        update();
        window.addEventListener('scroll', update, { passive: true });
      })();
    </script>
  </body>
</html>
