---
import { Image } from 'astro:assets';
import { features } from './features';

// App Store-style promotional posters (852×1846 PNG in src/assets/showcase).
// Astro emits sized WebP variants at build time.
import todayShot from '../../assets/showcase/today.png';
import classesShot from '../../assets/showcase/classes.png';
import eventsShot from '../../assets/showcase/events.png';
import campusShot from '../../assets/showcase/campus.png';

const shots = {
  today: todayShot,
  classes: classesShot,
  events: eventsShot,
  campus: campusShot,
} as const;

// Four posters, in tab order. Profile has no poster — see features.ts.
const posters = features.filter((f) => f.poster);
---

<section class="showcase" aria-labelledby="showcase-title">
  <div class="section-head">
    <h2 id="showcase-title">Straight from the app</h2>
    <p class="section-lede">
      Classes, events, deadlines, and campus buildings, as they look on your phone.
    </p>
  </div>

  <ul class="shelf" role="list" tabindex="0" aria-label="Screenshots of the JJAY app">
    {
      posters.map((f) => (
        <li class="slide">
          <Image
            class="slide-img"
            src={shots[f.key as keyof typeof shots]}
            alt={f.alt}
            widths={[300, 530, 852]}
            sizes="(min-width: 980px) 265px, (min-width: 560px) 260px, 58vw"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .showcase {
    padding: 56px 0 8px;
  }

  .shelf {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  .slide {
    margin: 0;
  }

  .slide-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 22px;
    border: 0.5px solid var(--home-hairline);
    box-shadow:
      0 1px 2px rgba(17, 17, 20, 0.04),
      0 16px 32px -14px rgba(40, 87, 164, 0.3);
  }

  /* Progressive: browsers with scroll-driven animations get a soft rise as the
     shelf enters view. The staggered ranges make the posters resolve in sequence
     rather than all at once. Everyone else simply sees them. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .slide {
        animation: rise-in both;
        animation-timeline: view();
        animation-range: entry 0% entry 50%;
      }

      .slide:nth-child(2) {
        animation-range: entry 4% entry 54%;
      }

      .slide:nth-child(3) {
        animation-range: entry 8% entry 58%;
      }

      .slide:nth-child(4) {
        animation-range: entry 12% entry 62%;
      }
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Below the four-across width the shelf becomes a swipeable snap carousel that
     bleeds to the edge of the screen, the same pattern the site used before. */
  @media (max-width: 979px) {
    .shelf {
      display: flex;
      gap: 16px;
      margin-inline: -24px;
      padding: 4px 24px 18px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .shelf::-webkit-scrollbar {
      display: none;
    }

    .slide {
      flex: 0 0 clamp(200px, 58vw, 260px);
      scroll-snap-align: center;
    }
  }
</style>
