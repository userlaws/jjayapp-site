---
import AppStoreButton from '../AppStoreButton.astro';
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta-main">
    <img class="cta-icon" src="/icon-160.png" alt="" width="160" height="160" />
    <div class="cta-text">
      <h2 id="cta-title">Your campus. In your pocket.</h2>
      <p class="cta-sub">Download JJAY for free on the App Store.</p>
    </div>
  </div>
  <div class="cta-action">
    <AppStoreButton />
    <p class="cta-meta">
      Free <span aria-hidden="true">•</span> No ads <span aria-hidden="true">•</span> Account optional
      <span aria-hidden="true">•</span> iOS only
    </p>
  </div>
  <p class="cta-script" aria-hidden="true">See more.<br />Do more.<br />At John Jay.</p>
</section>

<style>
  .cta {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 28px 40px;
    margin-top: 24px;
    padding: 40px 48px;
    border-radius: 28px;
    background:
      radial-gradient(60% 120% at 100% 0%, rgba(228, 238, 253, 0.9), transparent 70%),
      var(--surface);
    border: 0.5px solid var(--home-hairline);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .cta-main {
    display: flex;
    align-items: center;
    gap: 22px;
    min-width: 0;
  }

  .cta-icon {
    flex: none;
    width: 76px;
    height: 76px;
    border-radius: 22%;
    box-shadow:
      var(--shadow-card),
      0 10px 24px rgba(40, 87, 164, 0.28);
  }

  .cta h2 {
    margin: 0 0 0.25rem;
    font-size: clamp(1.625rem, 2.8vw, 2.125rem);
    font-weight: 780;
    letter-spacing: -0.03em;
    color: var(--home-ink);
  }

  .cta-sub {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--text-secondary);
  }

  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .cta-meta {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .cta-meta span {
    margin-inline: 0.3em;
  }

  /* decorative sign-off, desktop only */
  .cta-script {
    margin: 0;
    padding-left: 8px;
    font-family: 'Snell Roundhand', 'Bradley Hand', 'Segoe Script', 'Brush Script MT', cursive;
    font-size: 1.625rem;
    line-height: 1.15;
    color: var(--home-blue);
    transform: rotate(-6deg);
    white-space: nowrap;
  }

  @media (max-width: 1040px) {
    .cta {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .cta-script {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .cta {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding: 36px 24px;
      border-radius: 24px;
    }

    .cta-main {
      flex-direction: column;
      gap: 16px;
    }

    .cta-action {
      align-items: center;
    }

    .cta-meta {
      white-space: normal;
    }
  }
</style>
