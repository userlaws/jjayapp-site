---
import { features, icons } from './features';
---

<section class="overview" aria-labelledby="overview-title">
  <div class="section-head">
    <h2 id="overview-title">Everything you need for campus</h2>
    <p class="section-lede">Five core features, one simple app.</p>
  </div>
  <ul class="feature-grid" role="list">
    {
      features.map((f) => (
        <li class="feature-card" style={`--c: ${f.color}; --tint: ${f.tint}`}>
          <span class="roundel" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <Fragment set:html={icons[f.key]} />
            </svg>
          </span>
          <h3>{f.name}</h3>
          <p>{f.blurb}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .overview {
    padding: 56px 0 8px;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 28px 18px 24px;
    background: var(--surface);
    border: 0.5px solid var(--home-hairline);
    border-radius: 22px;
    box-shadow: var(--shadow-card);
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .feature-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--home-shadow-hover);
    }
  }

  .roundel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    color: #ffffff;
    background: var(--c);
    box-shadow:
      0 0 0 6px var(--tint),
      0 6px 14px -6px var(--c);
    margin-bottom: 4px;
  }

  .roundel svg {
    width: 26px;
    height: 26px;
  }

  .feature-card h3 {
    margin: 1rem 0 0.3rem;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--home-ink);
  }

  .feature-card p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-secondary);
    text-wrap: balance;
  }

  @media (max-width: 1000px) {
    .feature-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .feature-card {
      padding: 22px 14px 20px;
      border-radius: 18px;
    }

    .feature-card:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      transition: box-shadow 220ms ease;
    }

    .feature-card:hover {
      transform: none;
    }
  }
</style>
