---
import fs from 'node:fs';
import path from 'node:path';
import AppStoreButton from '../AppStoreButton.astro';
import { icons } from './features';

// Real capture of the Today tab from the app running in the iOS Simulator
// (644×1400 PNG in public/screenshots). Replace the file, rebuild, done —
// a neutral skeleton stands in if it's missing.
const heroShot = fs.existsSync(path.join(process.cwd(), 'public/screenshots/today.png'));

// Floating callouts around the phone — each one is a thing the Today tab really shows.
const callouts = [
  {
    key: 'deadline',
    title: 'Spring Recess Begins',
    sub: 'Stay on top of deadlines',
    icon: '<path d="M12 3.5 2.8 19.5h18.4z"/><path d="M12 9.5v4.5M12 17h.01"/>',
  },
  {
    key: 'event',
    kicker: '6:00 PM',
    title: 'Cultural Night',
    sub: 'Campus events at a glance',
    icon: icons.events,
  },
  {
    key: 'open',
    title: 'See what’s open on campus',
    sub: 'Libraries, gyms, and more',
    icon: icons.campus,
  },
  {
    key: 'classes',
    title: 'Find your classes',
    sub: 'Browse subjects and professors',
    icon: '<path d="M2.5 9.5 12 5l9.5 4.5L12 14z"/><path d="M6 11.75V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.25"/><path d="M21.5 9.5V15"/>',
  },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow fade-up">Classes <span aria-hidden="true">•</span> Events <span aria-hidden="true">•</span> Campus <span aria-hidden="true">•</span> All together</p>
    <h1 id="hero-title" class="fade-up" style="animation-delay: 40ms">
      Everything John Jay,<br /><span class="accent">in one place.</span>
    </h1>
    <p class="lede fade-up" style="animation-delay: 80ms">
      JJAY is a student-built companion app for John Jay students that puts useful campus
      information in one place. Browse classes and professors, discover campus events, check
      building and facility information, keep track of important deadlines, and quickly see what’s
      happening around campus.
    </p>
    <div class="hero-actions fade-up" style="animation-delay: 120ms">
      <AppStoreButton />
      <a class="hero-changelog t-learn" href="/changelog"
        >What’s new
        <span class="t-learn-chevron"
          ><svg
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8"></path>
            <path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12"></path>
          </svg></span
        ></a
      >
    </div>
    <p class="hero-meta fade-up" style="animation-delay: 160ms">
      Free <span aria-hidden="true">•</span> No ads <span aria-hidden="true">•</span> Account optional
      <span aria-hidden="true">•</span> iOS only
    </p>
  </div>

  <div class="hero-stage fade-up" style="animation-delay: 120ms" aria-hidden="true">
    <div class="glow"></div>
    <div class="phone">
      <div class="phone-screen">
        {
          heroShot ? (
            <img
              class="phone-img"
              src="/screenshots/today.png"
              alt=""
              width="644"
              height="1400"
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <div class="shot-skeleton">
              <span class="sk-island" />
              <span class="sk-bar" style="width: 38%" />
              <span class="sk-bar sk-bar-lg" style="width: 55%" />
              <span class="sk-card" />
              <span class="sk-card sk-card-short" />
              <span class="sk-bar" style="width: 44%" />
              <span class="sk-card sk-card-short" />
              <span class="sk-card sk-card-short" />
              <span class="sk-bar" style="width: 30%" />
              <span class="sk-card" />
            </div>
          )
        }
      </div>
    </div>
    {
      callouts.map((c) => (
        <div class={`callout callout-${c.key}`}>
          <span class="callout-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <Fragment set:html={c.icon} />
            </svg>
          </span>
          <span class="callout-text">
            {c.kicker && <span class="callout-kicker">{c.kicker}</span>}
            <span class="callout-title">{c.title}</span>
            <span class="callout-sub">{c.sub}</span>
          </span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 500px);
    align-items: center;
    gap: 32px 40px;
    padding: 40px 0 24px;
    overflow-x: clip;
  }

  .hero-copy {
    max-width: 560px;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--home-blue);
  }

  .eyebrow span {
    margin-inline: 0.35em;
    opacity: 0.6;
  }

  .hero h1 {
    font-size: clamp(2.125rem, 4vw, 3.4rem);
    font-weight: 780;
    line-height: 1.04;
    text-wrap: wrap; /* the <br> decides the break, not balance */
    letter-spacing: -0.035em;
    color: var(--home-ink);
    margin: 0 0 1.125rem;
  }

  .hero h1 .accent {
    color: var(--home-blue);
  }

  .hero .lede {
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 52ch;
    margin-bottom: 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin: 1.75rem 0 1.125rem;
  }

  .hero-changelog {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-weight: 500;
    text-decoration: none;
  }

  .hero-meta {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    text-wrap: balance;
  }

  .hero-meta span {
    margin-inline: 0.3em;
  }

  /* ------------------------------ stage -------------------------------- */

  /* a fixed-aspect canvas: the phone and the callouts are positioned as
     percentages of it, so the composition scales as one piece */
  .hero-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 560 / 700;
    container-type: inline-size;
    justify-self: end;
  }

  .glow {
    position: absolute;
    inset: 4% -2% 2%;
    border-radius: 50%;
    background: radial-gradient(
      55% 50% at 50% 48%,
      rgba(96, 148, 230, 0.34),
      rgba(160, 196, 245, 0.16) 55%,
      transparent 78%
    );
    pointer-events: none;
  }

  .phone {
    position: absolute;
    top: 2%;
    left: 50%;
    transform: translateX(-50%);
    width: 56%;
    padding: 2.4cqi;
    border-radius: 9.5cqi;
    background: var(--ink);
    box-shadow: var(--shadow-lift);
  }

  .phone-screen {
    position: relative;
    aspect-ratio: 644 / 1400;
    border-radius: 7.5cqi;
    overflow: hidden;
    background: var(--bg);
  }

  /* absolutely positioned so nothing can distort or crop it */
  .phone-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot-skeleton {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 18px 16px;
  }

  .sk-island {
    align-self: center;
    width: 44px;
    height: 13px;
    border-radius: 999px;
    background: var(--hairline);
    margin-bottom: 8px;
  }

  .sk-bar {
    height: 8px;
    border-radius: 4px;
    background: var(--hairline);
  }

  .sk-bar-lg {
    height: 14px;
    border-radius: 7px;
  }

  .sk-card {
    width: 100%;
    height: 52px;
    border-radius: 12px;
    background: var(--surface);
    border: 0.5px solid var(--hairline);
  }

  .sk-card-short {
    height: 38px;
  }

  /* ----------------------------- callouts ------------------------------ */

  .callout {
    position: absolute;
    display: flex;
    align-items: flex-start;
    gap: 2.2cqi;
    width: 37%;
    padding: 2.6cqi 2.8cqi;
    border-radius: 3.6cqi;
    background: rgba(255, 255, 255, 0.92);
    border: 0.5px solid rgba(40, 87, 164, 0.12);
    box-shadow:
      0 1px 2px rgba(17, 17, 20, 0.04),
      0 14px 34px -10px rgba(40, 87, 164, 0.28);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: clamp(10px, 2.6cqi, 14px);
    line-height: 1.3;
  }

  .callout-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.4em;
    height: 2.4em;
    border-radius: 0.75em;
    color: var(--c);
    background: var(--c-soft);
  }

  .callout-icon svg {
    width: 1.3em;
    height: 1.3em;
  }

  .callout-text {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    min-width: 0;
  }

  .callout-kicker {
    font-weight: 700;
    color: var(--c);
  }

  .callout-title {
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--home-ink);
  }

  .callout-sub {
    font-size: 0.86em;
    color: var(--text-tertiary);
  }

  .callout-deadline {
    --c: #c92a2a;
    --c-soft: #fdecec;
    top: 9%;
    left: 0;
  }

  .callout-deadline .callout-title {
    color: var(--c);
  }

  .callout-event {
    --c: #7b4fb6;
    --c-soft: #f0e9fa;
    top: 47%;
    left: 0;
  }

  .callout-open {
    --c: #1f8a4c;
    --c-soft: #e6f5ec;
    top: 20%;
    right: 0;
  }

  .callout-classes {
    --c: #2857a4;
    --c-soft: #e4eaf6;
    top: 58%;
    right: 0;
  }

  /* ----------------------------- entrance ------------------------------ */

  /* texts-reveal motion (transitions.dev), as a load-time animation:
     blurred 12px rise, 40ms stagger via inline animation-delay */
  @media (prefers-reduced-motion: no-preference) {
    .fade-up {
      opacity: 0;
      transform: translateY(var(--stagger-distance));
      filter: blur(var(--stagger-blur));
      animation: fade-up var(--stagger-dur) var(--stagger-ease) forwards;
    }
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* ---------------------------- responsive ----------------------------- */

  @media (max-width: 1100px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
    }
  }

  @media (max-width: 940px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 24px;
      gap: 12px;
    }

    .hero-copy {
      max-width: 600px;
      margin-inline: auto;
      text-align: center;
    }

    .hero .lede {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-stage {
      justify-self: center;
      width: 100%;
      max-width: 520px;
      margin-top: 20px;
    }
  }

  @media (max-width: 520px) {
    .eyebrow {
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
    }

    .hero-stage {
      width: 100%;
      aspect-ratio: 560 / 760;
    }

    .phone {
      width: 62%;
      top: 3%;
    }

    .callout {
      width: 38%;
    }

    .callout-deadline {
      top: 7%;
    }

    .callout-open {
      top: 24%;
    }

    .callout-event {
      top: 52%;
    }

    .callout-classes {
      top: 66%;
    }
  }
</style>
