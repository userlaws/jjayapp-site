---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const MONTHS = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];

function formatDate(date: string): string {
  const [year, month, day] = date.split('-');
  const name = MONTHS[Number(month) - 1];
  return day ? `${name} ${Number(day)}, ${year}` : `${name} ${year}`;
}

const releases = (await getCollection('changelog')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);

const entries = await Promise.all(
  releases.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Base
  title="Changelog — JJAY Campus Companion"
  description="Every JJAY Campus Companion release — App Store builds and over-the-air updates — in one place."
>
  <h1>Changelog</h1>
  <p class="lede">
    Some fixes ship as over-the-air updates that replace the app’s code in place without a new
    App Store build, so they never appear in the App Store’s “What’s New” — every release, both
    kinds, is listed here.
  </p>

  <div class="timeline">
    {
      entries.map(({ entry, Content }) => (
        <article class="release" id={entry.id} data-type={entry.data.type}>
          <div class="release-meta mono">
            <span class={`tag ${entry.data.type === 'ota' ? 'tag-ota' : 'tag-binary'}`}>
              {entry.data.type === 'ota' ? 'OTA update' : 'App Store release'}
            </span>
            <span class="release-version">v{entry.data.version}</span>
            <span aria-hidden="true">·</span>
            <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
          </div>
          <h2><a href={`#${entry.id}`}>{entry.data.title}</a></h2>
          <div class="release-notes">
            <Content />
          </div>
        </article>
      ))
    }
  </div>
</Base>

<style>
  h1 {
    margin-top: 3rem;
  }

  /* the changelog is a timeline, so it's drawn as one: a line with a stop
     per release — blue for App Store builds, gold for OTA updates */
  .timeline {
    position: relative;
    padding-left: 38px;
    margin-top: 3rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 10px;
    width: 4px;
    border-radius: 2px;
    background: var(--track);
  }

  .release {
    position: relative;
    margin-top: 3rem;
    scroll-margin-top: 88px;
  }

  .release:first-child {
    margin-top: 0;
  }

  .release::before {
    content: '';
    position: absolute;
    left: -36px;
    top: 4px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--surface);
    box-shadow: 0 1px 3px rgba(14, 14, 17, 0.25);
  }

  .release[data-type='ota']::before {
    background: var(--gold);
  }

  .release-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--text-tertiary);
  }

  .release-meta .tag {
    font-family: var(--font);
  }

  .release-version {
    font-weight: 600;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .release h2 {
    margin: 0.75rem 0 0.5rem;
  }

  .release h2 a {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .release h2 a:hover {
      text-decoration: underline;
      text-decoration-thickness: 1.5px;
      text-underline-offset: 3px;
    }
  }

  .release-notes {
    color: var(--text-secondary);
  }

  .release-notes :global(ul) {
    margin: 0;
    padding-left: 1.25rem;
  }

  .release-notes :global(li) {
    margin-bottom: 0.375rem;
  }

  .release-notes :global(li::marker) {
    color: var(--text-tertiary);
  }
</style>
