---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

// Stroke icon paths (24×24 viewBox), shared by the tab cards and the phone mock's tab bar.
const icons: Record<string, string> = {
  today:
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/>',
  classes:
    '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15.5H6.5A2.5 2.5 0 0 0 4 21z"/><path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20"/>',
  events:
    '<rect x="3.5" y="5" width="17" height="16" rx="2.5"/><path d="M3.5 10h17M8 2.5V6M16 2.5V6"/>',
  campus:
    '<path d="M4 21V5.5L12 3l8 2.5V21"/><path d="M2.5 21h19"/><path d="M9.5 21v-4.5h5V21"/><path d="M9 9.5h.5M14.5 9.5h.5M9 13.5h.5M14.5 13.5h.5"/>',
  profile:
    '<circle cx="12" cy="8" r="3.5"/><path d="M5 20.5c1.2-3.6 3.9-5 7-5s5.8 1.4 7 5"/>',
};

const tabs = [
  { key: 'today', name: 'Today', blurb: 'Your day at a glance — classes, events, and campus hours.' },
  { key: 'classes', name: 'Classes', blurb: 'Your courses, with professor ratings and reviews from students.' },
  { key: 'events', name: 'Events', blurb: 'What’s happening on campus, from the college calendar.' },
  { key: 'campus', name: 'Campus', blurb: 'Buildings and facilities, with what’s open right now.' },
  { key: 'profile', name: 'Profile', blurb: 'Your account, your reviews, your preferences.' },
];

// Drop real 1179×2556 PNGs into public/screenshots/ with these names and
// the skeleton placeholders below are replaced at the next build.
const shots = [
  { file: 'today.png', label: 'Today' },
  { file: 'classes.png', label: 'Classes' },
  { file: 'events.png', label: 'Events' },
].map((shot) => ({
  ...shot,
  exists: fs.existsSync(path.join(process.cwd(), 'public/screenshots', shot.file)),
}));
---

<Base
  title="JJAY Campus Companion — the unofficial app for John Jay students"
  description="Classes, campus events, facilities, and professor reviews for John Jay College — in one free iOS app. An independent student project."
  wide
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow fade-up">For John Jay students</p>
      <h1 class="fade-up" style="animation-delay: 60ms">John Jay,<br />in your pocket.</h1>
      <p class="lede fade-up" style="animation-delay: 120ms">
        Classes, campus events, building hours, and professor reviews — one free app, built by a
        John Jay student for John Jay students.
      </p>
      <div class="hero-actions fade-up" style="animation-delay: 180ms">
        <a class="btn-appstore" href="https://apps.apple.com/app/id6761637912">
          <svg class="apple-logo" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path
              d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
            ></path>
          </svg>
          <span class="badge-text">
            <small>Download on the</small>
            <strong>App Store</strong>
          </span>
        </a>
        <a class="hero-changelog" href="/changelog">What’s new →</a>
      </div>
      <p class="hero-meta muted small fade-up" style="animation-delay: 240ms">
        Free · No ads · Account optional · iOS only for now
      </p>
    </div>

    <div class="hero-visual fade-up" style="animation-delay: 200ms" aria-hidden="true">
      <div class="phone">
        <div class="phone-screen">
          <div class="mock-status">
            <span class="mock-time">9:41</span>
            <span class="island"></span>
            <span class="mock-time" style="visibility: hidden">9:41</span>
          </div>
          <div class="mock-body">
            <p class="mock-greeting">Good morning</p>
            <p class="mock-title">Today</p>

            <div class="mock-card">
              <span class="mock-chip">Up next</span>
              <p class="mock-course">CJBS 101 · Intro to Criminal Justice</p>
              <p class="mock-sub">10:50 AM – 12:05 PM · Room 3.63</p>
            </div>

            <div class="mock-card">
              <p class="mock-label">On campus today</p>
              <div class="mock-row">
                <span class="mock-dot"></span>
                <span class="mock-row-text">Fall Career Fair · L2 Atrium</span>
                <span class="mock-row-time">12 PM</span>
              </div>
              <div class="mock-row">
                <span class="mock-dot"></span>
                <span class="mock-row-text">Chess Club · Room 1.119</span>
                <span class="mock-row-time">1:40</span>
              </div>
            </div>

            <div class="mock-card">
              <div class="mock-row">
                <span class="mock-row-text">Lloyd Sealy Library</span>
                <span class="mock-open">Open until 10 PM</span>
              </div>
            </div>

            <div class="mock-card">
              <p class="mock-label">Top rated this week</p>
              <div class="mock-row">
                <span class="mock-row-text">Prof. J. Rivera · Criminal Law</span>
                <span class="mock-rating">★ 4.6</span>
              </div>
              <div class="mock-row">
                <span class="mock-row-text">Prof. A. Okafor · Forensic Psych</span>
                <span class="mock-rating">★ 4.5</span>
              </div>
            </div>
          </div>
          <div class="mock-tabbar">
            {
              tabs.map((tab, i) => (
                <span class={`mock-tab ${i === 0 ? 'active' : ''}`}>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <Fragment set:html={icons[tab.key]} />
                  </svg>
                  <span>{tab.name}</span>
                </span>
              ))
            }
          </div>
          <div class="mock-home"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="tabs-section" aria-labelledby="whats-inside">
    <p class="eyebrow">What’s inside</p>
    <h2 id="whats-inside">Five tabs, no clutter.</h2>
    <ul class="tab-grid" role="list">
      {
        tabs.map((tab) => (
          <li class="card tab-card">
            <span class="tab-glyph" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <Fragment set:html={icons[tab.key]} />
              </svg>
            </span>
            <h3>{tab.name}</h3>
            <p>{tab.blurb}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shots-section" aria-labelledby="screenshots">
    <p class="eyebrow">Screenshots</p>
    <h2 id="screenshots">A quick look</h2>
    <div class="shot-grid">
      {
        shots.map((shot) =>
          shot.exists ? (
            <figure class="shot-figure">
              <div class="shot">
                <img
                  src={`/screenshots/${shot.file}`}
                  alt={`Screenshot of the ${shot.label} tab`}
                  width="1179"
                  height="2556"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="muted small">{shot.label}</figcaption>
            </figure>
          ) : (
            <figure class="shot-figure">
              <div class="shot shot-skeleton" aria-hidden="true">
                <span class="sk-island" />
                <span class="sk-bar" style="width: 38%" />
                <span class="sk-bar sk-bar-lg" style="width: 55%" />
                <span class="sk-card" />
                <span class="sk-card sk-card-short" />
                <span class="sk-bar" style="width: 44%" />
                <span class="sk-card sk-card-short" />
                <span class="sk-card sk-card-short" />
                <span class="sk-bar" style="width: 30%" />
                <span class="sk-card" />
              </div>
              <figcaption class="muted small">{shot.label} · coming soon</figcaption>
            </figure>
          )
        )
      }
    </div>
  </section>
</Base>

<style>
  /* ------------------------------- hero ------------------------------- */

  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px 64px;
    padding: 48px 0 24px;
  }

  .hero-copy {
    max-width: 560px;
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 0.625rem;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5.5vw, 3.4rem);
    margin: 0 0 1rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin: 1.75rem 0 1.125rem;
  }

  .hero-changelog {
    font-weight: 500;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-changelog:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .hero-meta {
    margin: 0;
  }

  /* ---------------------------- phone mock ----------------------------- */

  .hero-visual {
    justify-self: end;
  }

  .phone {
    width: 296px;
    padding: 10px;
    border-radius: 50px;
    background: #101014;
    border: 1px solid var(--hairline);
  }

  .phone-screen {
    display: flex;
    flex-direction: column;
    aspect-ratio: 1179 / 2556;
    border-radius: 40px;
    overflow: hidden;
    background: var(--bg);
  }

  @media (prefers-color-scheme: dark) {
    .phone {
      background: #17171b;
    }

    .phone-screen {
      background: #0a0a0c;
    }
  }

  .mock-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px 4px;
  }

  .mock-time {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .island {
    width: 72px;
    height: 21px;
    border-radius: 999px;
    background: #101014;
  }

  .mock-body {
    flex: 1;
    padding: 10px 16px 0;
    min-height: 0;
  }

  .mock-greeting {
    margin: 0;
    font-size: 11px;
    color: var(--text-tertiary);
  }

  .mock-title {
    margin: 0 0 10px;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .mock-card {
    background: var(--surface);
    border: 0.5px solid var(--hairline);
    border-radius: 12px;
    padding: 10px 12px;
    margin-bottom: 9px;
  }

  .mock-chip {
    display: inline-block;
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-text);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 2px 7px;
    margin-bottom: 6px;
  }

  .mock-course {
    margin: 0 0 2px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
  }

  .mock-sub {
    margin: 0;
    font-size: 10px;
    color: var(--text-tertiary);
  }

  .mock-label {
    margin: 0 0 6px;
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .mock-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
  }

  .mock-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--accent);
    flex: none;
  }

  .mock-row-text {
    font-size: 10.5px;
    font-weight: 500;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mock-row-time {
    font-size: 10px;
    color: var(--text-tertiary);
  }

  .mock-open {
    font-size: 10px;
    font-weight: 550;
    color: var(--accent-text);
  }

  .mock-rating {
    font-size: 10px;
    font-weight: 600;
    color: var(--gold);
  }

  .mock-tabbar {
    display: flex;
    border-top: 0.5px solid var(--hairline);
    padding: 8px 8px 2px;
  }

  .mock-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    font-size: 8px;
    font-weight: 500;
    color: var(--text-tertiary);
  }

  .mock-tab.active {
    color: var(--accent-text);
  }

  .mock-tab svg {
    width: 17px;
    height: 17px;
  }

  .mock-home {
    height: 4px;
    width: 88px;
    border-radius: 999px;
    background: var(--text-tertiary);
    opacity: 0.5;
    margin: 8px auto 8px;
  }

  /* ----------------------------- sections ------------------------------ */

  .tabs-section,
  .shots-section {
    padding-top: 3.5rem;
  }

  .tabs-section h2,
  .shots-section h2 {
    margin-top: 0;
  }

  .tab-grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }

  .tab-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent-text);
    margin-bottom: 12px;
  }

  .tab-glyph svg {
    width: 20px;
    height: 20px;
  }

  .tab-card h3 {
    margin: 0 0 0.25rem;
  }

  .tab-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  /* ---------------------------- screenshots ----------------------------- */

  .shot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 24px;
    max-width: 760px;
    margin-top: 1.5rem;
  }

  .shot-figure {
    margin: 0;
    text-align: center;
  }

  .shot-figure figcaption {
    margin-top: 10px;
  }

  .shot {
    aspect-ratio: 1179 / 2556;
    border-radius: 26px;
    border: 0.5px solid var(--hairline);
    background: var(--surface);
    overflow: hidden;
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot-skeleton {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 18px 16px;
  }

  .sk-island {
    align-self: center;
    width: 44px;
    height: 13px;
    border-radius: 999px;
    background: var(--hairline);
    margin-bottom: 8px;
  }

  .sk-bar {
    height: 8px;
    border-radius: 4px;
    background: var(--hairline);
  }

  .sk-bar-lg {
    height: 14px;
    border-radius: 7px;
  }

  .sk-card {
    width: 100%;
    height: 52px;
    border-radius: 12px;
    background: var(--bg);
    border: 0.5px solid var(--hairline);
  }

  .sk-card-short {
    height: 38px;
  }

  /* ----------------------------- entrance ------------------------------- */

  @media (prefers-reduced-motion: no-preference) {
    .fade-up {
      opacity: 0;
      transform: translateY(10px);
      animation: fade-up 550ms var(--ease-out) forwards;
    }
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ----------------------------- responsive ----------------------------- */

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 32px;
    }

    .hero-visual {
      justify-self: center;
      padding-top: 16px;
    }

    .phone {
      width: 258px;
    }
  }
</style>
