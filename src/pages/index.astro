---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

// Stroke icon paths (24×24 viewBox), shared by the route roundels and the phone mock's tab bar.
const icons: Record<string, string> = {
  today:
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/>',
  classes:
    '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15.5H6.5A2.5 2.5 0 0 0 4 21z"/><path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20"/>',
  events:
    '<rect x="3.5" y="5" width="17" height="16" rx="2.5"/><path d="M3.5 10h17M8 2.5V6M16 2.5V6"/>',
  campus:
    '<path d="M4 21V5.5L12 3l8 2.5V21"/><path d="M2.5 21h19"/><path d="M9.5 21v-4.5h5V21"/><path d="M9 9.5h.5M14.5 9.5h.5M9 13.5h.5M14.5 13.5h.5"/>',
  profile:
    '<circle cx="12" cy="8" r="3.5"/><path d="M5 20.5c1.2-3.6 3.9-5 7-5s5.8 1.4 7 5"/>',
};

// The tab-bar order in the app, drawn as stops on a line. Roundel colors are
// this site's own line palette — dark enough for white icons to pass contrast.
const tabs = [
  { key: 'today', name: 'Today', color: '#2857a4', blurb: 'Your day at a glance — classes, events, and campus hours.' },
  { key: 'classes', name: 'Classes', color: '#1f8a4c', blurb: 'Your courses, with professor ratings and reviews from students.' },
  { key: 'events', name: 'Events', color: '#7b4fb6', blurb: 'What’s happening on campus, from the college calendar.' },
  { key: 'campus', name: 'Campus', color: '#c05f0e', blurb: 'Buildings and facilities, with what’s open right now.' },
  { key: 'profile', name: 'Profile', color: '#a87a20', blurb: 'Your account, your reviews, your preferences.' },
];

const shotDir = path.join(process.cwd(), 'public/screenshots');

// Real captures from the app running in the iOS Simulator (644×1400 PNG).
// Replace the files, rebuild, done.
const heroShot = fs.existsSync(path.join(shotDir, 'professors.png'));

const shots = [
  { file: 'today.png', label: 'Today' },
  { file: 'classes.png', label: 'Classes' },
  { file: 'campus.png', label: 'Campus' },
].map((shot) => ({
  ...shot,
  exists: fs.existsSync(path.join(shotDir, shot.file)),
}));
---

<Base
  title="JJAY Campus Companion — the app for John Jay students"
  description="Classes, campus events, facilities, and professor reviews for John Jay College — in one free iOS app."
  wide
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MobileApplication',
      name: 'JJAY Campus Companion',
      operatingSystem: 'iOS',
      applicationCategory: 'EducationApplication',
      description:
        'Classes, campus events, building hours, and professor reviews for John Jay College students — in one free iOS app.',
      url: 'https://jjayapp.com',
      image: 'https://jjayapp.com/icon-180.png',
      installUrl: 'https://apps.apple.com/app/id6761637912',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })}
  />

  <section class="hero">
    <div class="hero-copy">
      <img class="app-icon fade-up" src="/icon-160.png" alt="" width="160" height="160" />
      <h1 class="fade-up" style="animation-delay: 40ms">John Jay,<br />in your pocket.</h1>
      <p class="lede fade-up" style="animation-delay: 80ms">
        Classes, campus events, building hours, and professor reviews — one free app, built by a
        John Jay student for John Jay students.
      </p>
      <div class="hero-actions fade-up" style="animation-delay: 120ms">
        <a class="btn-appstore" href="https://apps.apple.com/app/id6761637912">
          <svg class="apple-logo" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path
              d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
            ></path>
          </svg>
          <span class="badge-text">
            <small>Download on the</small>
            <strong>App Store</strong>
          </span>
        </a>
        <a class="hero-changelog t-learn" href="/changelog"
          >What’s new
          <span class="t-learn-chevron"
            ><svg
              viewBox="0 0 16 16"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8"></path>
              <path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12"></path>
            </svg></span
          ></a
        >
      </div>
      <p class="hero-meta mono muted fade-up" style="animation-delay: 160ms">
        Free · No ads · Account optional · iOS only
      </p>
    </div>

    <div class="hero-visual fade-up" style="animation-delay: 120ms" aria-hidden="true">
      <div class="phone">
        <div class="phone-screen">
          {
            heroShot ? (
              <img
                class="phone-img"
                src="/screenshots/professors.png"
                alt=""
                width="644"
                height="1400"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <>
                <div class="mock-status">
                  <span class="mock-time">9:41</span>
                  <span class="island" />
                  <span class="mock-time" style="visibility: hidden">
                    9:41
                  </span>
                </div>
                <div class="mock-body">
                  <p class="mock-greeting">Good morning</p>
                  <p class="mock-title">Today</p>
                  <div class="mock-card">
                    <span class="mock-chip">Up next</span>
                    <p class="mock-course">CJBS 101 · Intro to Criminal Justice</p>
                    <p class="mock-sub">10:50 AM – 12:05 PM · Room 3.63</p>
                  </div>
                  <div class="mock-card">
                    <div class="mock-row">
                      <span class="mock-row-text">Lloyd Sealy Library</span>
                      <span class="mock-open">Open until 10 PM</span>
                    </div>
                  </div>
                </div>
                <div class="mock-tabbar">
                  {tabs.map((tab, i) => (
                    <span class={`mock-tab ${i === 0 ? 'active' : ''}`}>
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <Fragment set:html={icons[tab.key]} />
                      </svg>
                      <span>{tab.name}</span>
                    </span>
                  ))}
                </div>
                <div class="mock-home" />
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="route-section band" aria-labelledby="whats-inside">
    <h2 id="whats-inside">Five stops, one line.</h2>
    <p class="section-lede">The whole app is a tab bar — here’s the route.</p>
    <ol class="route" role="list">
      {
        tabs.map((tab) => (
          <li class="stop">
            <span class="roundel" style={`background: ${tab.color}`} aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <Fragment set:html={icons[tab.key]} />
              </svg>
            </span>
            <div class="stop-text">
              <h3>{tab.name}</h3>
              <p>{tab.blurb}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="shots-section" aria-labelledby="screenshots">
    <h2 id="screenshots">Straight from the app</h2>
    <div class="shot-grid">
      {
        shots.map((shot) =>
          shot.exists ? (
            <figure class="shot-figure">
              <div class="shot">
                <img
                  src={`/screenshots/${shot.file}`}
                  alt={`Screenshot of the ${shot.label} tab`}
                  width="644"
                  height="1400"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="mono muted">{shot.label}</figcaption>
            </figure>
          ) : (
            <figure class="shot-figure">
              <div class="shot shot-skeleton" aria-hidden="true">
                <span class="sk-island" />
                <span class="sk-bar" style="width: 38%" />
                <span class="sk-bar sk-bar-lg" style="width: 55%" />
                <span class="sk-card" />
                <span class="sk-card sk-card-short" />
                <span class="sk-bar" style="width: 44%" />
                <span class="sk-card sk-card-short" />
                <span class="sk-card sk-card-short" />
                <span class="sk-bar" style="width: 30%" />
                <span class="sk-card" />
              </div>
              <figcaption class="mono muted">{shot.label} · coming soon</figcaption>
            </figure>
          )
        )
      }
    </div>
  </section>

  <section class="cta-band" aria-labelledby="get-the-app">
    <div class="cta-inner">
      <div class="cta-left">
        <img class="cta-icon" src="/icon-160.png" alt="" width="160" height="160" />
        <div>
          <h2 id="get-the-app">Free on the App&nbsp;Store.</h2>
          <p class="cta-sub mono">iOS only · No ads · Account optional</p>
        </div>
      </div>
      <a class="btn-appstore btn-appstore-inverse" href="https://apps.apple.com/app/id6761637912">
        <svg class="apple-logo" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path
            d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
          ></path>
        </svg>
        <span class="badge-text">
          <small>Download on the</small>
          <strong>App Store</strong>
        </span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------- hero ------------------------------- */

  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px 64px;
    padding: 56px 0 32px;
  }

  .hero-copy {
    max-width: 560px;
  }

  .app-icon {
    display: block;
    width: 76px;
    height: 76px;
    border-radius: 22%;
    box-shadow:
      var(--shadow-card),
      0 10px 24px rgba(40, 87, 164, 0.28);
    margin-bottom: 1.375rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5.5vw, 3.6rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin: 1.75rem 0 1.25rem;
  }

  .hero-changelog {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-weight: 500;
    text-decoration: none;
  }

  .hero-meta {
    margin: 0;
    text-wrap: balance;
  }

  /* ---------------------------- phone frame ----------------------------- */

  .hero-visual {
    position: relative;
    justify-self: end;
  }

  /* soft accent glow lifting the phone off the page */
  .hero-visual::before {
    content: '';
    position: absolute;
    inset: -48px -72px;
    z-index: -1;
    background: radial-gradient(50% 46% at 50% 44%, rgba(40, 87, 164, 0.16), transparent 72%);
    pointer-events: none;
  }

  .phone {
    width: 296px;
    padding: 10px;
    border-radius: 50px;
    background: var(--ink);
    box-shadow: var(--shadow-lift);
  }

  .phone-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 644 / 1400;
    border-radius: 40px;
    overflow: hidden;
    background: var(--bg);
  }

  /* absolutely positioned so flex sizing can never distort or crop it */
  .phone-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* mock fallback, used only until a real hero screenshot exists */

  .mock-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px 4px;
  }

  .mock-time {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .island {
    width: 72px;
    height: 21px;
    border-radius: 999px;
    background: var(--ink);
  }

  .mock-body {
    flex: 1;
    padding: 10px 16px 0;
    min-height: 0;
  }

  .mock-greeting {
    margin: 0;
    font-size: 11px;
    color: var(--text-tertiary);
  }

  .mock-title {
    margin: 0 0 10px;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .mock-card {
    background: var(--surface);
    border: 0.5px solid var(--hairline);
    border-radius: 12px;
    padding: 10px 12px;
    margin-bottom: 9px;
  }

  .mock-chip {
    display: inline-block;
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-text);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 2px 7px;
    margin-bottom: 6px;
  }

  .mock-course {
    margin: 0 0 2px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
  }

  .mock-sub {
    margin: 0;
    font-size: 10px;
    color: var(--text-tertiary);
  }

  .mock-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
  }

  .mock-row-text {
    font-size: 10.5px;
    font-weight: 500;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mock-open {
    font-size: 10px;
    font-weight: 550;
    color: var(--accent-text);
  }

  .mock-tabbar {
    display: flex;
    border-top: 0.5px solid var(--hairline);
    padding: 8px 8px 2px;
  }

  .mock-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    font-size: 8px;
    font-weight: 500;
    color: var(--text-tertiary);
  }

  .mock-tab.active {
    color: var(--accent-text);
  }

  .mock-tab svg {
    width: 17px;
    height: 17px;
  }

  .mock-home {
    height: 4px;
    width: 88px;
    border-radius: 999px;
    background: var(--text-tertiary);
    opacity: 0.5;
    margin: 8px auto 8px;
  }

  /* ------------------------- route strip map ---------------------------- */

  .route-section {
    margin-top: 3.5rem;
    padding: 3.5rem 0 4rem;
  }

  .route-section h2,
  .shots-section h2 {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
  }

  .section-lede {
    color: var(--text-secondary);
    margin: 0;
  }

  .route {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
  }

  /* the line itself: runs through the roundel centers, terminal to terminal */
  .route::before {
    content: '';
    position: absolute;
    top: 24px;
    left: 10%;
    right: 10%;
    height: 4px;
    border-radius: 2px;
    background: var(--ink);
  }

  .stop {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .roundel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #ffffff;
    border: 4px solid var(--surface);
    box-shadow: 0 1px 3px rgba(14, 14, 17, 0.25);
    z-index: 1;
  }

  .roundel svg {
    width: 20px;
    height: 20px;
  }

  .stop-text h3 {
    margin: 0.75rem 0 0.25rem;
  }

  .stop-text p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* ---------------------------- screenshots ----------------------------- */

  .shots-section {
    padding-top: 4rem;
  }

  .shot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 24px;
    max-width: 760px;
    margin-top: 2rem;
  }

  .shot-figure {
    margin: 0;
    text-align: center;
  }

  .shot-figure figcaption {
    margin-top: 10px;
  }

  .shot {
    aspect-ratio: 644 / 1400;
    border-radius: 26px;
    border: 0.5px solid var(--hairline);
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot-skeleton {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 18px 16px;
  }

  .sk-island {
    align-self: center;
    width: 44px;
    height: 13px;
    border-radius: 999px;
    background: var(--hairline);
    margin-bottom: 8px;
  }

  .sk-bar {
    height: 8px;
    border-radius: 4px;
    background: var(--hairline);
  }

  .sk-bar-lg {
    height: 14px;
    border-radius: 7px;
  }

  .sk-card {
    width: 100%;
    height: 52px;
    border-radius: 12px;
    background: var(--bg);
    border: 0.5px solid var(--hairline);
  }

  .sk-card-short {
    height: 38px;
  }

  /* --------------------------- ink CTA band ----------------------------- */

  .cta-band {
    margin-top: 5rem;
    padding: 3.25rem 0;
    background: var(--ink);
    box-shadow: 0 0 0 100vmax var(--ink);
    clip-path: inset(0 -100vmax);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
  }

  .cta-left {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .cta-icon {
    width: 58px;
    height: 58px;
    border-radius: 22%;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    flex: none;
  }

  .cta-band h2 {
    color: #ffffff;
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    margin: 0 0 0.375rem;
  }

  .cta-sub {
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .btn-appstore-inverse {
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  /* ----------------------------- entrance ------------------------------- */

  /* texts-reveal motion (transitions.dev), as a load-time animation:
     blurred 12px rise, 40ms stagger via inline animation-delay */
  @media (prefers-reduced-motion: no-preference) {
    .fade-up {
      opacity: 0;
      transform: translateY(var(--stagger-distance));
      filter: blur(var(--stagger-blur));
      animation: fade-up var(--stagger-dur) var(--stagger-ease) forwards;
    }
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* ------------------------- scroll reveals ----------------------------- */

  /* progressive: browsers with scroll-driven animations get a rise-in as
     stops enter the viewport; everyone else just sees them */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stop {
        animation: rise-in both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ----------------------------- responsive ----------------------------- */

  @media (min-width: 721px) {
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .shot-figure {
          animation: rise-in both;
          animation-timeline: view();
          animation-range: entry 0% entry 55%;
        }
      }
    }
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 36px;
    }

    .hero-copy {
      max-width: 560px;
      margin-inline: auto;
      text-align: center;
    }

    .app-icon {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual {
      justify-self: center;
      padding-top: 20px;
    }

    .phone {
      width: 258px;
    }
  }

  /* mobile: screenshots become a swipeable snap carousel, edge to edge */
  @media (max-width: 720px) {
    .shot-grid {
      display: flex;
      gap: 16px;
      max-width: none;
      margin-inline: -24px;
      padding: 4px 24px 14px;
      overflow-x: auto;
