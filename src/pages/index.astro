---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FeatureOverview from '../components/home/FeatureOverview.astro';
import FeatureShowcase from '../components/home/FeatureShowcase.astro';
import BuiltFor from '../components/home/BuiltFor.astro';
import DownloadCta from '../components/home/DownloadCta.astro';
---

<Base
  title="JJAY Campus Companion — the app for John Jay students"
  description="Classes, campus events, facilities, and professor reviews for John Jay College — in one free iOS app."
  wide
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MobileApplication',
      name: 'JJAY Campus Companion',
      operatingSystem: 'iOS',
      applicationCategory: 'EducationApplication',
      description:
        'Classes, campus events, building hours, and professor reviews for John Jay College students — in one free iOS app.',
      url: 'https://jjayapp.com',
      image: 'https://jjayapp.com/icon-180.png',
      installUrl: 'https://apps.apple.com/app/id6761637912',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })}
  />

  <div class="home">
    <HomeHero />
    <FeatureOverview />
    <FeatureShowcase />
    <BuiltFor />
    <DownloadCta />
  </div>
</Base>

<style is:global>
  /* Landing-page-only styles. Astro ships a page's <style> with that page alone,
     so nothing here reaches /changelog, /support, or /privacy. */
  :root {
    --home-blue: #2b6be3;
    --home-ink: #0f172a;
    --home-hairline: rgba(40, 87, 164, 0.12);
    --home-shadow-hover: 0 2px 4px rgba(17, 17, 20, 0.04), 0 18px 40px -12px rgba(40, 87, 164, 0.28);
  }

  /* white page with a pale-blue wash behind the hero that fades out by the feature grid */
  body {
    background: linear-gradient(180deg, #edf3fd 0%, #f7faff 520px, #fbfcfe 820px, #fbfcfe 100%);
  }

  /* the product page gets a little more room than the text pages;
     the header keeps its own width */
  main > .wrap-wide {
    max-width: 1160px;
    overflow-x: clip;
  }

  .site-footer {
    background: transparent;
    margin-top: 4rem;
  }

  .home .section-head {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .home .section-head h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 3.2vw, 2.375rem);
    font-weight: 780;
    letter-spacing: -0.03em;
    color: var(--home-ink);
  }

  .home .section-lede {
    margin: 0;
    font-size: 1.125rem;
    color: var(--text-secondary);
  }
</style>
