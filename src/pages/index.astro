---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

const tabs = [
  { name: 'Today', blurb: 'Your day at a glance — classes, events, and campus hours.' },
  { name: 'Classes', blurb: 'Your courses, with professor ratings and reviews from students.' },
  { name: 'Events', blurb: 'What’s happening on campus, from the college calendar.' },
  { name: 'Campus', blurb: 'Buildings and facilities, with what’s open right now.' },
  { name: 'Profile', blurb: 'Your account, your reviews, your preferences.' },
];

// Drop real 1179×2556 PNGs into public/screenshots/ with these names and
// the placeholders below are replaced at the next build.
const shots = [
  { file: 'today.png', label: 'Today' },
  { file: 'classes.png', label: 'Classes' },
  { file: 'events.png', label: 'Events' },
].map((shot) => ({
  ...shot,
  exists: fs.existsSync(path.join(process.cwd(), 'public/screenshots', shot.file)),
}));
---

<Base
  title="JJAY Campus Companion — the unofficial app for John Jay students"
  description="Classes, campus events, facilities, and professor reviews for John Jay College — in one free iOS app. An independent student project."
  wide
>
  <section class="hero">
    <h1>John Jay, in your pocket.</h1>
    <p class="lede">
      Classes, campus events, building hours, and professor reviews — one free app, built by a
      John Jay student for John Jay students.
    </p>
    <div class="hero-actions">
      <a class="btn-appstore" href="https://apps.apple.com/app/id6761637912">
        <svg class="apple-logo" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path
            d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
          ></path>
        </svg>
        <span class="badge-text">
          <small>Download on the</small>
          <strong>App Store</strong>
        </span>
      </a>
    </div>
    <p class="hero-meta muted small">
      Free · No ads · Account optional · iOS only for now — there is no Android version yet.
    </p>
    <p class="small"><a href="/changelog">See what’s new in the latest update</a></p>
  </section>

  <section class="tabs-section" aria-labelledby="whats-inside">
    <h2 id="whats-inside">What’s inside</h2>
    <p class="section-lede">Five tabs, no clutter.</p>
    <ul class="tab-grid" role="list">
      {
        tabs.map((tab) => (
          <li class="card tab-card">
            <h3>{tab.name}</h3>
            <p>{tab.blurb}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shots-section" aria-labelledby="screenshots">
    <h2 id="screenshots">A quick look</h2>
    <div class="shot-grid">
      {
        shots.map((shot) =>
          shot.exists ? (
            <figure class="shot">
              <img
                src={`/screenshots/${shot.file}`}
                alt={`Screenshot of the ${shot.label} tab`}
                width="1179"
                height="2556"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ) : (
            <figure class="shot shot-placeholder" aria-label={`${shot.label} tab screenshot coming soon`}>
              <span class="shot-label">{shot.label}</span>
              <span class="muted small">Screenshot coming soon</span>
            </figure>
          )
        )
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 4.5rem 0 1rem;
    max-width: 620px;
  }

  .hero-actions {
    margin: 1.75rem 0 1rem;
  }

  .hero-meta {
    margin-bottom: 0.375rem;
  }

  .section-lede {
    color: var(--text-secondary);
    margin-top: -0.25rem;
  }

  .tab-grid {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }

  .tab-card h3 {
    margin: 0 0 0.25rem;
  }

  .tab-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .shot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
    max-width: 820px;
    margin-top: 1.25rem;
  }

  .shot {
    margin: 0;
    aspect-ratio: 1179 / 2556;
    border-radius: 24px;
    border: 0.5px solid var(--hairline);
    background: var(--surface);
    overflow: hidden;
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .shot-label {
    font-weight: 600;
    color: var(--text-tertiary);
  }
</style>
